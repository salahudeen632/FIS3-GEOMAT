FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0/pipe";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ 0 0 0 1 0 0 0 ];

internalField   uniform 293;

boundaryField
{
    pipe_ends
    {
        type            zeroGradient;
    }
    pipe_to_PCM
    {
         type            coupledTemperature;
               value           uniform 293;

    }
    pipe_to_CF
    {
        type            coupledTemperature;
               value           uniform 293;

    }
}


