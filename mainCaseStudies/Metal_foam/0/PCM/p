FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0/PCM";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    metalfoam_PCM_ends
    {
         type            calculated;
        value           $internalField;
    }
    PCM_to_pipe
    {
         type            calculated;
        value           $internalField;
    }
    PCM_to_enhanced_grout_PCM
    {
         type            calculated;
        value           $internalField;
    }
}

