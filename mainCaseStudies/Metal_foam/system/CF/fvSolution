FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system/fluid";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "p_rgh.*"
    {
         solver          PCG;
        preconditioner  DIC;
        tolerance       1e-06;
        relTol          0.1;
    }

    "(U|h|k|epsilon).*"
    {
        solver           PBiCGStab;
        preconditioner   DILU;
        tolerance        1e-6;
        relTol           0.2;
    }

    rho
    {
        solver           diagonal;
    }

    rhoFinal
    {
        $rho;
    }
}

PIMPLE
{
    momentumPredictor          yes;
    nOuterCorrectors           1;
    nCorrectors                2;
    nNonOrthogonalCorrectors   2;

    pRefCell                   0;
    pRefValue                  0;
}

relaxationFactors
{
    fields
    {
        rho            1;
        p_rgh           0.7;
    }

    equations
    {
        U               0.3;
        h               0.7;
        k               0.7;
        epsilon         0.7;
    }
}
