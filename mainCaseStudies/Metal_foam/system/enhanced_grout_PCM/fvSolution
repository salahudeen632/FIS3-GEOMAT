FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system/PCM";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "p_rgh.*|p.*"
    {
        solver          GAMG;
        smoother        symGaussSeidel;
        tolerance       1e-7;
        relTol          0.01;
    }

    "Ts.*"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-8;
        relTol          0.01;
    }

    "(U|h|Tp|k|epsilon).*"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-8;
        relTol          0.01;
    }

    "alpha.*"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-8;
        relTol          0.01;
    }
 rho
    {
        solver           diagonal;
    }

    rhoFinal
    {
        $rho;
    }

}

PIMPLE
{
    momentumPredictor       yes;

    nOuterCorrectors        2;
    nCorrectors             2;
    nNonOrthogonalCorrectors 1;
     pRefCell                   0;
    pRefValue                  0;
    p_rghRefCell               0;
    p_rghRefValue              0;
    nThermalCorrectors         8;

    residualControl
    {
        p_rgh       1e-4;
        U           1e-5;
        h           1e-6;
        T           1e-6;
        Tp          1e-6;
        Ts          1e-6;
    }
}

relaxationFactors
{
    fields
    {
        p_rgh       0.7;
        p           0.7;
    }

    equations
    {
        U           0.3;
        h           0.7;
        T           0.7;
        Tp          0.7;
        Ts          0.7;
        k           0.7;
        epsilon     0.7;
    }
}
