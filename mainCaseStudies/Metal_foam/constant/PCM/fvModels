FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant/PCM";
    object      fvOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

pcmPhaseChange
{
    type            solidificationMeltingSource;
    active          no;
    selectionMode   cellZone;
    cellZone        PCM;


    solidificationMeltingSourceCoeffs
    {
        select      all;

        thermoMode  thermo;

        Tsol        293;
        Tliq        303;

        L           23000;
         rhoRef      1530;

    beta        0;

    relax       0.7;

    Cu          10000;

    q           1e-3;
    }
}
