FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant/PCM";
    object      pcmMetalFoamProperties;
}

// PCM + metal foam LTNE properties for region PCM.
// PCM values are taken from constant/PCM/physicalProperties and the old
// solidificationMeltingSource: rho=1530, Cp=1759.12, k=2.5, mu=0.00358,
// Tsol=290, Tliq=303, L=23000.

solveFlow      yes;
epsilon  0.85;
PPI            10;

rhoPs          [1 -3 0 0 0 0 0] 1530;
rhoPl          [1 -3 0 0 0 0 0] 1530;
CpPs           [0 2 -2 -1 0 0 0] 1759.12;
CpPl           [0 2 -2 -1 0 0 0] 1759.12;
kPs            [1 1 -3 -1 0 0 0] 2.5;
kPl            [1 1 -3 -1 0 0 0] 2.5;
muPl           [1 -1 -1 0 0 0 0] 0.00358;
Lf             [0 2 -2 0 0 0 0] 23000;
Tm             [0 0 0 1 0 0 0] 297.8;
phaseChangeDeltaT [0 0 0 1 0 0 0] 5;

beta           [0 0 0 -1 0 0 0] 0;
Tref           [0 0 0 1 0 0 0] 293;
Tinf           [0 0 0 1 0 0 0] 293;

// These are optional standalone heat-flux/loss controls. For cht coupling,
// keep them zero/none and use coupledTemperature on Tp interfaces.
hotWallThermalMode none;
qHotWall       [1 0 -3 0 0 0 0] 0;
qBottom        [1 0 -3 0 0 0 0] 0;
hLoss          [1 0 -3 -1 0 0 0] 0;

// Copper foam defaults. Change these for aluminium/nickel foam.
rhoFoam        [1 -3 0 0 0 0 0] 8960;
CpFoam         [0 2 -2 -1 0 0 0] 385;
kFoam          [1 1 -3 -1 0 0 0] 401;

hpsModel       Zukauskas;
hpsConstant    100000;
hpsMin         1000;

viscosityA     0;
mushyCu        [0 0 -1 0 0 0 0] 1e4;
q              1e-3;
useViscosityDamping false;