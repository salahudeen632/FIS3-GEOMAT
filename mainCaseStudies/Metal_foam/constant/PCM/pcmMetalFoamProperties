FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant/PCM";
    object      pcmMetalFoamProperties;
}

// RT27 paraffin impregnated into open-cell aluminium foam.
// SI units are used throughout.

solveFlow      yes;
epsilon        0.85;
PPI            10;

rhoPs          [1 -3 0 0 0 0 0] 870;
rhoPl          [1 -3 0 0 0 0 0] 760;
CpPs           [0 2 -2 -1 0 0 0] 2400;
CpPl           [0 2 -2 -1 0 0 0] 1800;
kPs            [1 1 -3 -1 0 0 0] 0.24;
kPl            [1 1 -3 -1 0 0 0] 0.15;
muPl           [1 -1 -1 0 0 0 0] 3.42e-3;
Lf             [0 2 -2 0 0 0 0] 179000;
Tm             [0 0 0 1 0 0 0] 300.15;
phaseChangeDeltaT [0 0 0 1 0 0 0] 3;

beta           [0 0 0 -1 0 0 0] .5e-3;
Tref           [0 0 0 1 0 0 0] 300.15;
Tinf           [0 0 0 1 0 0 0] 293;

// These are optional standalone heat-flux/loss controls. For CHT coupling,
// keep them zero/none and use coupledTemperature on Tp interfaces.
hotWallThermalMode none;
qHotWall       [1 0 -3 0 0 0 0] 0;
qBottom        [1 0 -3 0 0 0 0] 0;
hLoss          [1 0 -3 -1 0 0 0] 0;

// Aluminium foam properties.
rhoFoam        [1 -3 0 0 0 0 0] 8960;
CpFoam         [0 2 -2 -1 0 0 0] 385;
kFoam          [1 1 -3 -1 0 0 0] 401;


hpsModel       Zukauskas;
hpsConstant    100000;
hpsMin         1000;

viscosityA     0;
mushyCu        [0 0 -1 0 0 0 0] 1e4;
q              1e-3;
useViscosityDamping false;
