FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant/PCM";
    object      physicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState rhoConst;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        molWeight       100;
    }

    equationOfState
    {
        rho             1530;
    }

    thermodynamics
    {
        Cp              1759.12;
        Hf              0;
    }

    transport
    {
        mu              0.00358;
         kappa           2.65;
    }
}
