FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant/sand";
    object      physicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heSolidThermo;
    mixture         pureMixture;
   transport       constIsoSolid;
    thermo          eConst;
    equationOfState rhoConst;
    specie          specie;
     energy          sensibleInternalEnergy;
}

mixture
{
    specie
    {
        molWeight       60;
    }

    equationOfState
    {
        rho             2647;
    }

    thermodynamics
    {
        Cv              830;
        Hf              0;
    }

    transport
    {
        kappa           2.65;
    }
}
