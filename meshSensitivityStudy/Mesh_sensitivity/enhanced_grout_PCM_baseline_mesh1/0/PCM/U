FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0/PCM";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    PCM_ends
    {
        type            noSlip;
    }

   
     PCM_to_sand
    {
        type            noSlip;
    }

     PCM_to_pipe
    {
        type            noSlip;
    }
}
