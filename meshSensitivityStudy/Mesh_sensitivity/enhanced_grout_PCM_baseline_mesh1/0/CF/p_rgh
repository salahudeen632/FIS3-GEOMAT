FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0/CF";
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ 1 -1 -2 0 0 0 0 ];

internalField   uniform 0;

boundaryField
{
  
    outlet_CF
    {
        type            fixedValue;
        value           $internalField;
    }
    inlet_CF
    {
        type            fixedFluxPressure;
        value           $internalField;
    }
      CF_to_pipe
    {
        type            fixedFluxPressure;
        value           $internalField;
    }
}

